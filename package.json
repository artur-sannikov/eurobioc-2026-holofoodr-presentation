{
  "dependencies": {
    "@slidev/theme-seriph": "^0.25.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "scripts": {
    "build": "slidev build",
    "dev": "slidev --open",
    "export": "slidev export"
  },
  "overrides": [
    {
      "files": [
        "slides.md",
        "pages/*.md"
      ],
      "options": {
        "parser": "slidev",
        "plugins": [
          "prettier-plugin-slidev"
        ]
      }
    }
  ]
}
